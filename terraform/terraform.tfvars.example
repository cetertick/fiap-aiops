# terraform.tfvars.example
# ---------------------------------------------------------------------------
# Copie este arquivo para "terraform.tfvars" e ajuste conforme necessario.
# Os valores abaixo sao os mesmos defaults usados em aula (AWS Academy).
# ---------------------------------------------------------------------------

project_name = "aiops-lab"

aws_region = "us-east-1"

vpc_cidr = "10.0.0.0/16"

cluster_name    = "aiops-lab-eks"
cluster_version = "1.30"

node_instance_type = "t3.medium"
node_desired_size  = 2
node_min_size      = 2
node_max_size      = 4

# Mantenha "true" durante a aula (conta AWS Academy Learner Lab).
# Mude para "false" apenas se for rodar em uma conta AWS "de verdade",
# fora do Academy, com permissao para criar roles/policies IAM.
use_lab_role  = true
lab_role_name = "LabRole"
